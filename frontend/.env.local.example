# OneSeek.ai Frontend Environment Variables

# Backend URL for FastAPI server (required)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8001

# Optional: Direct vLLM URL if you want to test direct connection
# VLLM_URL=http://localhost:8000
# VLLM_API_KEY=

# Optional: Token limit for context window
# VLLM_TOKEN_LIMIT=4096
