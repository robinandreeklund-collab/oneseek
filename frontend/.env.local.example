# OneSeek.ai Frontend Environment Variables

# Backend URL for FastAPI server (required)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8001

# Optional: Model name to display in UI (defaults to llama3-8b)
# VLLM_MODEL=llama3-8b

# Optional: Token limit for context window (defaults to 4096)
# VLLM_TOKEN_LIMIT=4096

# Note: VLLM_URL is NOT needed - OneSeek.ai uses FastAPI backend, not direct vLLM connection
