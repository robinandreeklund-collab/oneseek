# Code Router and Tools Configuration
# Copy this to backend/.env and customize for your environment

# ============================================================
# Core vLLM Configuration
# ============================================================
VLLM_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ

# ============================================================
# Code Tools Configuration
# ============================================================

# Python REPL - Execute Python code
# Default: false
ENABLE_PYTHON_REPL=true

# Linux Sandbox - Run shell commands in isolated environment
# Requires: WSL (Windows) or Docker
# Default: false
ENABLE_LINUX_SANDBOX=true

# File System Tool - Read/write files in workspace
# Default: false
ENABLE_FILE_SYSTEM_TOOL=true

# React Sandbox - Create and preview Next.js applications
# Requires: Node.js and npm
# Default: false
ENABLE_REACT_SANDBOX=true

# ============================================================
# Test Tools Configuration
# ============================================================

# Python Test Tools - Run pytest, pylint, mypy
# Enables automated testing and quality checks for Python code
# Default: false
ENABLE_PYTHON_TEST_TOOL=true

# JavaScript Test Tools - Run jest, vitest, eslint, tsc
# Enables automated testing and quality checks for JavaScript/TypeScript code
# Default: false
ENABLE_JAVASCRIPT_TEST_TOOL=true

# ============================================================
# Workspace Configuration
# ============================================================

# Root directory for file system operations
# All file operations are restricted to this directory for security
# Default: /tmp/oneseek_workspace
CODE_WORKSPACE_ROOT=/path/to/your/workspace

# Root directory for React/Next.js projects
# Default: /tmp/oneseek_react_sandboxes
REACT_SANDBOX_ROOT=/path/to/react/sandboxes

# Docker image for Linux sandbox (if Docker is used instead of WSL)
# Default: ubuntu:latest
DOCKER_SANDBOX_IMAGE=ubuntu:latest

# ============================================================
# Existing Configuration (keep these)
# ============================================================

# Vespa Cloud (for RAG)
VESPA_URL=https://your-app.your-tenant.vespa-cloud.net
VESPA_CERT_PATH=/path/to/certificate.pem
VESPA_KEY_PATH=/path/to/private-key.pem

# Tavily API (optional - for premium web search)
TAVILY_API_KEY=your-api-key-here

# ============================================================
# Security Settings
# ============================================================

# Maximum execution time for sandbox commands (seconds)
# Prevents infinite loops or long-running processes
# Default: 30
SANDBOX_TIMEOUT=30

# Maximum file size for file operations (MB)
# Prevents reading/writing extremely large files
# Default: 10
MAX_FILE_SIZE_MB=10

# ============================================================
# Feature Flags
# ============================================================

# Enable clarification mode
ENABLE_CLARIFICATION=false

# Enable background investigation
ENABLE_BACKGROUND_INVESTIGATION=true

# Enable web search
ENABLE_WEB_SEARCH=true

# Enable AI comparison mode
ENABLE_AI_COMPARISON=false

# Enable debate mode
ENABLE_DEBATE_MODE=false
