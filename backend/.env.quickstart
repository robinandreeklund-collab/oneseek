# Quick start configuration for testing without Vespa

# vLLM Configuration (required)
VLLM_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ

# Model Settings
MODEL_TEMPERATURE=0.7
MAX_TOKENS=2048

# Vespa Cloud Configuration (optional - can be left empty for initial testing)
# The backend will work without Vespa, just without RAG enhancement
# Get these from https://console.vespa-cloud.com after creating a tenant

# VESPA_URL=https://your-app.your-tenant.vespa-cloud.net
# VESPA_CERT_PATH=/path/to/certificate.pem
# VESPA_KEY_PATH=/path/to/private-key.pem
