# Vespa Cloud Configuration
VESPA_URL=https://your-app.your-tenant.vespa-cloud.net
VESPA_CERT_PATH=/path/to/certificate.pem
VESPA_KEY_PATH=/path/to/private-key.pem

# vLLM Configuration
VLLM_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ

# Optional: Model temperature and other settings
MODEL_TEMPERATURE=0.7
MAX_TOKENS=2048

# Search Tools Configuration
# Tavily API Key (optional - for web search)
TAVILY_API_KEY=your-tavily-api-key-here

# AI Comparison / Debate OS - External Model API Keys (optional)
# OpenAI API Key for GPT-3.5
OPENAI_API_KEY=your-openai-api-key-here
# Google API Key for Gemini 2.5 Flash
GOOGLE_API_KEY=your-google-api-key-here
# DeepSeek API Key for DeepSeek Chat
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# xAI API Key for Grok-4 Fast Reasoning
XAI_API_KEY=your-xai-api-key-here
XAI_BASE_URL=https://api.x.ai/v1
